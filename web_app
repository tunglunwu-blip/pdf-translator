import os
import time
from pathlib import Path
import streamlit as st

# 匯入你原本的核心處理邏輯（請確保 pdf_en_to_zh_keep_layout.py 在同一資料夾）
import pdf_en_to_zh_keep_layout as pdf_core

st.set_page_config(
    page_title="PDF 原文書專業翻譯器",
    page_icon="📚",
    layout="centered"
)

st.title("📚 PDF 原文書專業翻譯器")
st.markdown("##### 免費 · 版面保持 · 600+ 頁長篇超穩定不崩潰")

# 側邊欄設定
with st.sidebar:
    st.header("⚙️ 翻譯參數設定")
    workers = st.slider("同時翻譯工作數 (Workers)", min_value=1, max_value=5, value=3, 
                        help="遇到 Google API 限流時請降為 1")
    delay = st.slider("每頁延遲時間 (秒)", min_value=0.0, max_value=2.0, value=0.25, step=0.05)
    font_scale = st.slider("中文預設字級縮放比例", min_value=0.5, max_value=1.0, value=0.92)
    min_font_size = st.number_input("最小允許字級 (pt)", min_value=2.0, max_value=10.0, value=4.0)
    
    st.info("💡 **公式保護機制已啟用**：數學方程式、上下標、DOI、網址將自動保留原樣不翻譯。")

# 檔案上傳
uploaded_file = st.file_uploader("拖曳或選擇要翻譯的英文 PDF 檔案", type=["pdf"])

if uploaded_file is not None:
    # 建立臨時儲存路徑
    temp_dir = Path("temp_pdf")
    temp_dir.mkdir(exist_ok=True)
    
    input_pdf_path = temp_dir / uploaded_file.name
    output_pdf_path = temp_dir / f"{input_pdf_path.stem}_中文.pdf"
    
    # 寫入上傳的檔案
    with open(input_pdf_path, "wb") as f:
        f.write(uploaded_file.getbuffer())
        
    st.success(f"已成功載入檔案：**{uploaded_file.name}**")
    
    # 開始翻譯按鈕
    if st.button("🚀 開始進行翻譯", type="primary"):
        status_box = st.empty()
        progress_bar = st.progress(0)
        
        try:
            status_box.info("🔍 正在分析 PDF 版面與結構...")
            doc = pdf_core.fitz.open(str(input_pdf_path))
            total_pages = doc.page_count
            
            # 解析所有文字區塊
            all_regions = []
            page_regions = {}
            for page_index in range(total_pages):
                page = doc[page_index]
                regions = pdf_core.extract_regions(page, page_index)
                page_regions[page_index] = regions
                all_regions.extend(regions)
                
            status_box.info(f"📄 全書共 {total_pages} 頁，共擷取到 {len(all_regions)} 個可翻譯文字區塊。")
            
            # 設定翻譯快取，防止崩潰重來
            cache_path = output_pdf_path.with_name(f".{output_pdf_path.stem}_翻譯快取.json")
            cache = pdf_core.TranslationCache(cache_path, enabled=True)
            
            # 執行翻譯
            status_box.info("🌐 正在連線翻譯中，請保持此網頁開啟...")
            pdf_core.translate_regions(all_regions, cache, delay=delay, workers=workers)
            
            # 回填版面
            status_box.info("🎨 正在進行排版與中文字體嵌回...")
            chinese_font = pdf_core.resolve_chinese_font(None)
            
            for page_index in range(total_pages):
                regions = [r for r in page_regions.get(page_index, []) if r.translated_text]
                if regions:
                    page = doc[page_index]
                    font_name = pdf_core.prepare_font(page, chinese_font)
                    pdf_core.redact_original_text(page, regions)
                    for region in regions:
                        pdf_core.insert_fitted_text(
                            page, region, font_name, chinese_font, 
                            font_scale, min_font_size, 0.12, (0.08, 0.60, 0.82)
                        )
                # 更新進度條
                progress_bar.progress((page_index + 1) / total_pages)
                
            # 存檔
            pdf_core.save_document(doc, output_pdf_path)
            doc.close()
            
            status_box.success("🎉 翻譯完成！")
            
            # 提供下載按鈕
            with open(output_pdf_path, "rb") as f:
                st.download_button(
                    label="📥 下載翻譯好的 PDF",
                    data=f,
                    file_name=output_pdf_path.name,
                    mime="application/pdf",
                    type="primary"
                )
                
        except Exception as e:
            st.error(f"❌ 翻譯過程中發生錯誤：{str(e)}")
            st.warning("請試著將側邊欄的 Workers 設為 1，並把延遲時間調高後重新嘗試。")
